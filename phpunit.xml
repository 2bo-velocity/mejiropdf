<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="MejiroPDF Unit Test Suite">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Shell out to external validators (openssl, veraPDF); each test
             self-skips when its tool is absent. Select this suite by name to
             run only these. -->
        <testsuite name="MejiroPDF Integration Test Suite">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
